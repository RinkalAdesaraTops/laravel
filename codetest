public function store(Request $request)
    {
        $request->validate([
            'name' => 'required'
        ]);

        $category = Category::create($request->all());

        return response()->json($category);
    }

    $('#addCategory').submit(function(e){
    e.preventDefault();

    let id = $('#cat_id').val();

    let url = id ? '/categories/' + id : '/categories';
    let type = id ? 'PUT' : 'POST';

    $.ajax({
        type: type,
        url: url,
        data: {
            name: $('#name').val()
        },
        success: function(response){
            $('#row_' + response.id).html(`
                <td>${response.name}</td>
                <td>
                    <button onclick="editCategory(${response.id})">Edit</button>
                    <button onclick="deleteCategory(${response.id})">Delete</button>
                </td>
            `);
            $('#name').val('');
            $('#cat_id').remove();
        }
    });
});
